# Airship, served as static files.
#
# `{$CADDY_PROTOCOL:}` is set by `caddy-entrypoint.sh` from `CADDY_TLS`: empty
# enables automatic HTTPS, `http://` disables it for local testing. Same shape
# as the proxy services in this fleet.
#
# `{$AIRSHIP_PUBLIC_BASE_PATH:/}` is the one deployment value that is both a
# build argument and a runtime one. Vite inlined it into the bundle, so every
# URL the browser asks for carries that prefix; the Dockerfile lays `dist/` down
# at `/srv<base>` so the filesystem mirrors that URL space, which is what the
# Pages workflow does to the same build. The matchers below have to carry the
# prefix too — anchored at the origin root they match nothing on a subpath
# deployment, and the site then serves correctly while quietly losing its cache
# and service-worker headers. `caddy-entrypoint.sh` supplies the trailing slash
# Caddy will not.
#
# The header blocks below are not decoration. `public/_headers` is the
# Netlify/Cloudflare format and **Caddy does not read it**, so serving `dist/`
# without these would silently publish Airship with no Content-Security-Policy
# and no cross-origin isolation. The unconditional headers and complementary
# page/kernel CSP matchers are kept in step with `public/_headers` by hand, and
# two checks refuse a drift: `check-static-security.mjs` at review time and
# `deploy.sh --verify` on the deploying machine. Matcher-scoped caching headers
# remain outside the structural security comparison.

{$CADDY_PROTOCOL:}{$CADDY_DOMAIN:localhost}:{$CADDY_PORT:443} {
	root * /srv
	encode zstd gzip

	header {
		# Cross-origin isolation. `credentialless` is what lets the threaded
		# WASM runtime start its workers; drop these two and the semantic pack
		# fails to load with an error that looks like a bug in the pack.
		Cross-Origin-Embedder-Policy "credentialless"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"

		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), bluetooth=()"
		Referrer-Policy "no-referrer"
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"

		# Caddy announces itself by default; a version banner is free
		# reconnaissance and buys nothing.
		-Server
	}

	# The JavaScript kernel evaluates REPL cells with AsyncFunction. Keep its
	# `unsafe-eval` grant on the one hashed worker response. These complementary
	# matchers are deliberate: two Caddy `header` directives that both match the
	# worker are reordered by the adapter and the page policy wins last.
	@primeKernelWorker path {$AIRSHIP_PUBLIC_BASE_PATH:/}assets/*.prime-kernel-worker.js
	@notPrimeKernelWorker not path {$AIRSHIP_PUBLIC_BASE_PATH:/}assets/*.prime-kernel-worker.js
	header @notPrimeKernelWorker Content-Security-Policy "default-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; frame-src https://stackblitz.com https://accounts.google.com; object-src 'none'; script-src 'self' 'wasm-unsafe-eval' https://accounts.google.com; style-src 'self' 'unsafe-inline' https://accounts.google.com; img-src 'self' data: blob:; connect-src 'self' https: http://localhost:11434 http://127.0.0.1:11434 http://localhost:11435 http://127.0.0.1:11435 http://localhost:11436 http://127.0.0.1:11436 http://localhost:1234 http://127.0.0.1:1234 http://localhost:1235 http://127.0.0.1:1235 http://localhost:1236 http://127.0.0.1:1236; worker-src 'self' blob:; manifest-src 'self'; font-src 'self'; trusted-types default airship-static airship-worker airship-prime-kernel-worker airship-prime-kernel-worker-asset airship-semantic-worker airship-wasi-preview1-worker airship-opfs-worker airship-google-identity; require-trusted-types-for 'script'"
	header @primeKernelWorker Content-Security-Policy "default-src 'none'; script-src 'unsafe-eval'; connect-src 'none'; worker-src 'none'"

	# Content-addressed by the build, so a year is safe and a rebuild busts it.
	@immutable path {$AIRSHIP_PUBLIC_BASE_PATH:/}assets/* {$AIRSHIP_PUBLIC_BASE_PATH:/}semantic-pack/v1/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	# The service worker decides when the app updates. Caching it defeats that:
	# a stale worker keeps serving a stale build long after a deploy. The allowed
	# scope is the base path because that is the scope the app registers with
	# (`src/main.tsx`), not the origin.
	@nocache path {$AIRSHIP_PUBLIC_BASE_PATH:/}sw.js {$AIRSHIP_PUBLIC_BASE_PATH:/}release-manifest.json
	header @nocache Cache-Control "no-cache"
	header {$AIRSHIP_PUBLIC_BASE_PATH:/}sw.js Service-Worker-Allowed "{$AIRSHIP_PUBLIC_BASE_PATH:/}"

	# Hash-routed, but a refresh or a shared deep link can still reach a path
	# the build does not emit. The fallback is the base's index, not the origin's:
	# on a subpath deployment there is no `/index.html` on disk.
	try_files {path} {$AIRSHIP_PUBLIC_BASE_PATH:/}index.html
	file_server
}
