# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem
/playwright-report/
/test-results/

# Rust build output
/crates/*/target/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# The deployment template is meant to be committed; `.env*` above would eat it.
!.env.sample

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/.wrangler/
/outputs/
/work/
/.airship-lab/
/public/extension/releases/

# Disposable, read-only upstream study checkouts. The tracked catalog and
# clean-room rules live in /references.
/references/checkouts/

# Screenshots captured while auditing the running UI. Evidence for a review,
# regenerated by re-running the capture — the findings they support are written
# down in docs/audit/, which is what gets kept.
/.ui-capture/

# The same species, under the rule above rather than beside it. `.aesthetic/`
# held 419 committed files — 382 of them PNGs, 102 MB — of exactly this: probe
# scripts and before/after captures from design-review passes. Nothing built,
# tested, deployed or documented read them, and every `.aesthetic/` path the
# design-review documents cite (`shots/`, `tmp/phone/`, `memory/`,
# `lane-tools.mjs`) had already gone; what was committed was a different set
# that nothing cited at all. The findings those passes produced are in
# docs/design-review/ and docs/audit/, which is the part worth a clone's
# bandwidth.
/.aesthetic/

# Ground-truth sweep scripts written to drive the running app and report what a
# human receives. Same rule: the report is the artifact, not the harness.
/.sweep-tmp*.mjs

# Editor and agent working state that is not a repository-level decision.
/.kilo/
/.playwright-mcp/
/graphify-out/
/docs/_work/

# Sweep captures are evidence for a review, not source. They live in the
# scratchpad beside the rest of the campaign's screenshots.
shots/

# A measuring copy of the release gate, written by hand while re-taking
# readings. It is not the authority and must never be tracked beside it.
scripts/.gate-instrument.mjs
