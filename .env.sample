# Airship deployment — copy to .env and edit.

# The domain Caddy answers on. Point an A/AAAA record at this host first;
# Caddy provisions the certificate itself on first request.
CADDY_DOMAIN=airship.example.com

# 443 with TLS. For local testing use CADDY_PORT=8080 and CADDY_TLS=false.
CADDY_PORT=443
CADDY_TLS=true

# Caddy's plain-HTTP listener, published as `80:80` because Let's Encrypt
# validates HTTP-01 there. With CADDY_TLS=false nothing listens on it, so set
# CADDY_HTTP_BIND=80 to let Docker pick the host port instead of demanding 80.
# `./deploy.sh` option 2 does this for you.
#CADDY_HTTP_BIND=80

# Where the app is served from. `/` for a domain root. A subpath needs the
# trailing slash (`/airship/`).
AIRSHIP_PUBLIC_BASE_PATH=/

# Optional. Leave empty and Airship starts in Ephemeral page memory, which
# needs no registration. Setting the Google client ID switches the default to
# Drive. Nothing here tells the app its own origin — Google Identity Services
# authorizes the origin the page is actually served from — so set this only
# once `https://<CADDY_DOMAIN>` is listed under that client ID's Authorized
# JavaScript origins. Local Device remains available as the explicit encrypted
# offline choice.
VITE_GOOGLE_CLIENT_ID=

# Local MinIO is host-composed, not a stock storage choice. This composes the
# lab in or out of the bundle rather than merely permitting it: with anything
# other than the exact value `1`, the S3 object store, the lab setup panel and
# its stylesheet, the baked loopback endpoint and the S3/Cognito diagnostics are
# not built at all, and `npm run check:release` fails a release that contains
# them. Keep this off in normal builds; scripts/local-lab.mjs sets the opt-in.
VITE_AIRSHIP_ENABLE_LOCAL_LAB=0
