# Airship deployment — copy to .env and edit.

# The domain Caddy answers on. Point an A/AAAA record at this host first;
# Caddy provisions the certificate itself on first request.
CADDY_DOMAIN=airship.example.com

# 443 with TLS. For local testing use CADDY_PORT=8080 and CADDY_TLS=false.
CADDY_PORT=443
CADDY_TLS=true

# Caddy's plain-HTTP listener, published as `80:80` because Let's Encrypt
# validates HTTP-01 there. With CADDY_TLS=false nothing listens on it, so set
# CADDY_HTTP_BIND=80 to let Docker pick the host port instead of demanding 80.
# `./deploy.sh` option 2 does this for you.
#CADDY_HTTP_BIND=80

# Where the app is served from. `/` for a domain root. A subpath needs the
# trailing slash (`/airship/`).
AIRSHIP_PUBLIC_BASE_PATH=/

# The origin the app hands to providers for OAuth redirects. Must match the
# domain above exactly, scheme included, or sign-in comes back to nowhere.
VITE_AIRSHIP_PUBLIC_ORIGIN=https://airship.example.com

# Optional. Leave empty and Airship starts in Ephemeral page memory, which
# needs no registration. Setting the Google client ID switches the default to
# Drive, so set it only when the origin above is a registered redirect. Local
# Device remains available as the explicit encrypted offline choice.
VITE_GOOGLE_CLIENT_ID=

# Local MinIO is host-composed, not a stock storage choice. Keep this off in
# normal builds; scripts/local-lab.mjs alone sets the exact opt-in value `1`.
VITE_AIRSHIP_ENABLE_LOCAL_LAB=0

# Optional. Where "Install the companion extension" sends people. Leave empty
# and Airship points at the copy this build ships at `<base>extension/`, which
# is what a self-hosted deployment wants. Set it to a store listing if you
# publish the extension somewhere else.
VITE_AIRSHIP_EXTENSION_INSTALL_URL=
