
  /** The jig that takes agent-lifecycle events and journals airship turn protocol */
  private async onAgentEvent(event: AgentEvent): Promise<void> {
    if (this.aborted || this.disposed) return;
    const turnId = this.turnId;
    if (!turnId) return;

    switch (event.type) {
      case "agent_start": {
        this.turnIndex += 1;
        this.pendingStepRequestDigest = undefined;
        this.stepIndex = 0;
        this.stepEventCount = 0;
        this.finalAssistant = undefined;
        this.finalText = "";
        this.repeatCounts.clear();
        this.repeatWarnings.clear();
        break;
      }
      case "message_start": {
        break;
      }
      case "message_update": {
        this.stepEventCount += 1;
        if (this.stepEventCount > PRIME_MAX_STEP_EVENTS) {
          throw new Error(`prime step event cap exceeded (${PRIME_MAX_STEP_EVENTS}); the stream is too large to continue safely.`);
        }
        const delta = (event as import("../ai/types").AssistantMessageEvent | undefined)?.delta;
        if (delta && this.options.onSignal) this.options.onSignal({ type: "text-delta", turnId, text: delta });
        break;
      }
      case "message_end": {
        const message = (event as { message?: AgentMessage }).message;
        await this.onMessageEnd(turnId, message as AgentMessage);
        break;
      }
      case "tool_execution_start": {
        break;
      }
      case "tool_execution_end": {
        break;
      }
      case "agent_end": {
        await this.onAgentEnd(turnId, event as { messages?: AgentMessage[] });
        break;
      }
      case "turn_start":
      case "turn_end":
      case "turn.cancelled":
      case "turn.failed":
      case "turn.completed": {
        break;
      }
      default: {
        break;
      }
    }
  }

  private async onMessageEnd(turnId: string, message: AgentMessage): Promise<void> {
    if (!message) return;
    const role = (message as { role?: string }).role;

    if (role === "user") {
      return;
    }

    if (role === "assistant") {
      const assistant = message as AssistantMessage;
      if (assistant.stopReason === "toolUse") {
        await this.journalToolBatch(turnId, assistant);
        return;
      }
      if (assistant.stopReason === "stop") {
        this.finalAssistant = assistant;
        this.finalText = assistant.content.filter(
          (block): block is { type: "text"; text: string } => (block as { type?: string }).type === "text",
        ).map((block) => (block as { text: string }).text).join("");
        return;
      }
      if (assistant.stopReason === "error" || assistant.stopReason === "aborted") {
        return;
      }
      return;
    }

    if (role === "toolResult") {
      await this.journalToolResult(turnId, message as import("../ai/types").ToolResultMessage);
      return;
    }
  }

  private async journalToolBatch(turnId: string, assistant: AssistantMessage): Promise<void> {
    const text = assistant.content
      .filter((block): block is { type: "text"; text: string } => block.type === "text")
      .map((block) => block.text).join("");
    if (text.length > PRIME_MAX_ASSISTANT_CHARS) {
      throw new Error(`assistant text exceeded ${PRIME_MAX_ASSISTANT_CHARS} characters`);
    }
    const toolCalls = assistant.content.filter((c): c is import("../ai/types").ToolCall => c.type === "toolCall");
    if (toolCalls.length > PRIME_MAX_TOOL_CALLS_PER_STEP) {
      throw new Error(`prime tool-call cap exceeded (${PRIME_MAX_TOOL_CALLS_PER_STEP} per step)`);
    }

    for (const call of toolCalls) {
      if (!call.id || call.id.length > 512 || /[\r\n\f\v\x00-\x1f]/.test(call.id)) {
        throw new Error(`prime tool call operation id invalid: ${JSON.stringify(call.id)}`);
      }
      if (this.sessionOperationIds.has(call.id)) {
        throw new Error(`prime tool call operation id reused: ${JSON.stringify(call.id)}`);
      }
    }
    toolCalls.forEach((call) => this.sessionOperationIds.add(call.id));

    const drafts: EventDraft[] = [
      {
        type: "assistant.completed",
        turnId,
        operationId: this.pendingStepRequestId ?? this.pendingStepRequestDigest ?? "unknown",
        payload: {
          role: "assistant",
          finishReason: "tool-calls",
          content: text,
          toolCalls: toolCalls.map((call) => ({ id: call.id, name: call.name, arguments: call.arguments })),
        },
      },
      ...toolCalls.map((call): EventDraft => ({
        type: "tool.requested",
        turnId,
        operationId: call.id,
        payload: { call: { id: call.id, name: call.name, arguments: call.arguments } },
      })),
    ];
    await this.appendJournal(drafts);

    if (this.pendingStepRequestDigest !== undefined || this.pendingStepRequestId !== undefined) {
      await this.journalStepUsage(turnId, assistant);
      this.pendingStepRequestDigest = undefined;
      this.pendingStepRequestId = undefined;
    }
    this.reviewStepToolCalls(turnId, assistant, toolCalls);
  }
